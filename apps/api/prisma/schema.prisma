generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Moneda {
  CRC
  USD
}

enum Idioma {
  es
  en
}

enum Rol {
  SUPERADMIN
  DUENO
  MESERO
  COCINA
  CAJA
  REPARTIDOR
}

enum EstadoCuenta {
  ABIERTA
  PIDIO_CUENTA
  CERRADA
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum EstadoPedidoItem {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
}

enum TipoLlamada {
  MESERO
  CUENTA
}

enum ModoConfirmacion {
  SIEMPRE
  PRIMER_PEDIDO
  NUNCA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  SINPE
  MIXTO
}

enum OrigenPedido {
  CLIENTE
  MESERO
}

model Restaurante {
  id                       String           @id @default(uuid()) @db.Uuid
  nombre                   String
  slug                     String           @unique
  logoUrl                  String?
  telefono                 String?
  direccion                String?
  eslogan                  String? // personalización: frase bajo el nombre
  bannerUrl                String? // imagen ancha de portada del menú
  ubicacionUrl             String? // enlace de Google Maps ("Cómo llegar")
  colorAcento              String? // acento del menú del comensal; null = morado del diseño
  moneda                   Moneda           @default(CRC)
  idiomas                  Idioma[]         @default([es, en])
  porcentajeIva            Int              @default(13)
  porcentajeServicio       Int              @default(10)
  preciosIncluyenImpuestos Boolean          @default(true)
  activo                   Boolean          @default(true)
  // Suscripción (Fase 9): el registro empieza en COMPLETO con 30 días de prueba.
  plan                     Plan             @default(COMPLETO)
  planVenceEn              DateTime?
  suspendidoPorPago        Boolean          @default(false) // suspensión automática (un pago la levanta)
  // Wi-Fi del local: QR para conectarse en la tarjeta de la mesa (Fase 11)
  wifiNombre               String?
  wifiClave                String?
  // Factura electrónica (Fase 13): CABYS de los platos sin código propio (según la modalidad)
  cabysGeneral             String?
  modoConfirmacion         ModoConfirmacion @default(PRIMER_PEDIDO)
  zonaHoraria              String           @default("America/Costa_Rica")
  cerradoManual            Boolean          @default(false) // "Cerrar temporalmente"
  // Promoción del banner: si hay precioPromo, es el precio que se cobra por ese plato.
  platoDestacadoId         String?          @db.Uuid
  textoPromoEs             String?
  textoPromoEn             String?
  precioPromo              Int? // céntimos
  colorPromo               String? // fondo del banner de la promoción; null = oscuro del diseño
  // Pedidos en línea (Fase 5)
  enLineaActivo            Boolean          @default(false)
  enLineaRecoger           Boolean          @default(true)
  enLineaDomicilio         Boolean          @default(false)
  costoEnvio               Int              @default(0) // céntimos, fijo
  pedidoMinimo             Int              @default(0) // céntimos; 0 = sin mínimo
  zonaEntrega              String?
  sinpeNumero              String?
  sinpeNombre              String?
  tiempoEstimadoMin        Int              @default(25)
  minutosPagoSinpe         Int              @default(15) // tiempo del cliente para hacer el SINPE
  // Fidelidad: tarjeta de sellos de los pedidos en línea (Fase 8)
  fidelidadActiva          Boolean          @default(false)
  sellosMeta               Int              @default(8)
  premioFidelidad          String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  usuarios       Usuario[]
  dispositivos   Dispositivo[]
  vistasPlatos   VistaPlato[]
  estaciones     Estacion[]
  mesas          Mesa[]
  categorias     Categoria[]
  platos         Plato[]
  platoDestacado Plato?               @relation("PlatoDestacado", fields: [platoDestacadoId], references: [id], onDelete: SetNull)
  horarios       HorarioRestaurante[]
  grupos         GrupoModificadores[]
  modificadores  Modificador[]
  cuentas        Cuenta[]
  pedidos        Pedido[]
  llamadas       Llamada[]
  clientes       ClienteRegistrado[]
  canjes         CanjeSello[]
  pagosPlan      PagoSuscripcion[]
  turnosCaja     TurnoCaja[]
  configHacienda ConfigHacienda?
  comprobantes   Comprobante[]
}

model Usuario {
  id                  String    @id @default(uuid()) @db.Uuid
  restauranteId       String?   @db.Uuid // null solo para SUPERADMIN
  nombre              String
  email               String    @unique
  passwordHash        String
  debeCambiarPassword Boolean   @default(false) // tras restablecerla el dueño
  ultimoAcceso        DateTime?
  rol                 Rol
  estacionId          String?   @db.Uuid // COCINA: su estación; null = todas
  pinHash             String? // PIN de 4 dígitos para entrar en una tablet vinculada
  intentosPin         Int       @default(0)
  pinBloqueadoHasta   DateTime?
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  restaurante        Restaurante?           @relation(fields: [restauranteId], references: [id])
  estacion           Estacion?              @relation(fields: [estacionId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  pedidosConfirmados Pedido[]               @relation("PedidoConfirmadoPor")
  pedidosCreados     Pedido[]               @relation("PedidoCreadoPor")
  cuentasCerradas    Cuenta[]               @relation("CuentaCerradaPor")
  repartos           Cuenta[]               @relation("CuentaRepartidor")
  recuperaciones     RecuperacionPassword[]

  @@index([restauranteId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  tokenHash String   @unique
  expiraEn  DateTime
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Estacion {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  nombre        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante  Restaurante   @relation(fields: [restauranteId], references: [id])
  platos       Plato[]
  pedidoItems  PedidoItem[]
  usuarios     Usuario[]
  dispositivos Dispositivo[]

  @@unique([restauranteId, nombre])
  @@index([restauranteId])
}

model Mesa {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  numero        Int
  nombre        String?
  tokenQr       String   @unique
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  cuentas     Cuenta[]
  llamadas    Llamada[]

  @@unique([restauranteId, numero])
  @@index([restauranteId])
}

model Categoria {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  nombreEs      String
  nombreEn      String
  orden         Int      @default(0)
  activa        Boolean  @default(true)
  icono         String? // emoji que se muestra en el menú
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  platos      Plato[]

  @@index([restauranteId])
}

model Plato {
  id            String    @id @default(uuid()) @db.Uuid
  restauranteId String    @db.Uuid
  categoriaId   String    @db.Uuid
  estacionId    String    @db.Uuid
  nombreEs      String
  nombreEn      String
  descripcionEs String?
  descripcionEn String?
  precio        Int // céntimos
  fotoUrl       String? // 960 px (detalle)
  fotoMiniUrl   String? // 320 px (lista)
  agotado       Boolean   @default(false)
  activo        Boolean   @default(true)
  orden         Int       @default(0)
  alergenos     String[]  @default([])
  // Factura electrónica (Fase 13): código CABYS y tarifa de IVA propia (null = la del restaurante).
  cabys         String?
  tarifaIva     Int?
  // Menú del día (combo): se ofrece los días de la semana marcados (0 = domingo) o, a mano, en
  // una fecha puntual. Fijo (partes en la descripción) o con opciones (grupos de modificadores).
  menuDelDia    Boolean   @default(false)
  diasSemana    Int[]     @default([])
  fechaMenu     DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurante Restaurante          @relation(fields: [restauranteId], references: [id])
  destacadoEn Restaurante[]        @relation("PlatoDestacado")
  categoria   Categoria            @relation(fields: [categoriaId], references: [id])
  estacion    Estacion             @relation(fields: [estacionId], references: [id])
  grupos      GrupoModificadores[]
  pedidoItems PedidoItem[]
  vistas      VistaPlato[]

  @@index([restauranteId])
  @@index([categoriaId])
}

// restauranteId se agrega (no está en la spec) para filtrar por tenant sin joins.
model GrupoModificadores {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  platoId       String   @db.Uuid
  nombreEs      String
  nombreEn      String
  obligatorio   Boolean  @default(false)
  minimo        Int      @default(0)
  maximo        Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante   Restaurante   @relation(fields: [restauranteId], references: [id])
  plato         Plato         @relation(fields: [platoId], references: [id], onDelete: Cascade)
  modificadores Modificador[]

  @@index([restauranteId])
  @@index([platoId])
}

model Modificador {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  grupoId       String   @db.Uuid
  nombreEs      String
  nombreEn      String
  precioExtra   Int      @default(0) // céntimos
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante             @relation(fields: [restauranteId], references: [id])
  grupo       GrupoModificadores      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usos        PedidoItemModificador[]

  @@index([restauranteId])
  @@index([grupoId])
}

// --- Operación (Fase 2) ---

// Solo una cuenta no CERRADA por mesa: índice único parcial creado en SQL en la migración
// "cuenta_unica_abierta" (Prisma no soporta índices parciales en el schema).

model Cuenta {
  id                 String        @id @default(uuid()) @db.Uuid
  restauranteId      String        @db.Uuid
  mesaId             String?       @db.Uuid // null en pedidos en línea (para recoger / a domicilio)
  tipo               TipoCuenta    @default(MESA)
  estado             EstadoCuenta  @default(ABIERTA)
  verificada         Boolean       @default(false)
  // Totales en céntimos; los recalcula el servidor con calcularTotales() (packages/shared).
  subtotal           Int           @default(0)
  montoServicio      Int           @default(0)
  montoIva           Int           @default(0)
  total              Int           @default(0)
  metodoPago         MetodoPago?
  cerradaPorId       String?       @db.Uuid
  numeroComensales   Int? // cupo: lo dice el primero que escanea; sube al aceptar a alguien
  ingresoBloqueado   Boolean       @default(false) // demasiados intentos de entrar: nadie más se une
  rechazosIngreso    Int           @default(0)
  // Pedido en línea (Fase 5): quién pide, a dónde, cómo paga y en qué etapa va.
  numeroPedido       Int? // "Pedido #12" (correlativo por restaurante)
  clienteNombre      String?
  clienteTelefono    String?
  telefonoNormal     String? // últimos 8 dígitos del teléfono: identifica al cliente (Fase 8)
  clienteId          String?       @db.Uuid // cuenta del cliente, si pidió con sesión
  direccionEntrega   String?
  referenciaEntrega  String?
  latEntrega         Float? // punto marcado por el cliente en el mapa (Fase 7)
  lngEntrega         Float?
  repartidorId       String?       @db.Uuid
  efectivoCuadrado   Boolean       @default(false) // la caja recibió el efectivo del repartidor
  efectivoRecibidoEn DateTime? // cuándo (Fase 14: entra al turno de caja en ese momento)
  costoEnvio         Int           @default(0)
  pagoElegido        MetodoPago? // lo que dijo el cliente (efectivo o SINPE)
  comprobanteSinpe   String?
  pagoVerificado     Boolean       @default(false)
  pagarAntesDe       DateTime? // SINPE: límite para pagar; no entra a cocina sin el pago verificado
  etapa              EtapaEnLinea?
  tiempoEstimadoMin  Int?
  motivoRechazo      String?
  tokenSeguimiento   String?       @unique // enlace de seguimiento del cliente
  abiertaEn          DateTime      @default(now())
  cerradaEn          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  restaurante  Restaurante        @relation(fields: [restauranteId], references: [id])
  mesa         Mesa?              @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  cerradaPor   Usuario?           @relation("CuentaCerradaPor", fields: [cerradaPorId], references: [id])
  repartidor   Usuario?           @relation("CuentaRepartidor", fields: [repartidorId], references: [id])
  cliente      ClienteRegistrado? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pedidos      Pedido[]
  solicitudes  SolicitudIngreso[]
  pagos        PagoCuenta[]
  lineasCobro  LineaCobro[]
  comprobantes Comprobante[]
  sesiones     SesionCliente[]

  @@index([restauranteId])
  @@index([mesaId])
  @@index([restauranteId, estado, cerradaEn]) // reportes por rango de fechas
  @@index([restauranteId, tipo, etapa])
  @@index([restauranteId, repartidorId])
  @@index([restauranteId, telefonoNormal])
}

enum TipoCuenta {
  MESA
  RECOGER
  DOMICILIO
}

enum EtapaEnLinea {
  RECIBIDO
  ACEPTADO
  LISTO
  EN_CAMINO
  ENTREGADO
  RECHAZADO
}

model Pedido {
  id                 String       @id @default(uuid()) @db.Uuid
  restauranteId      String       @db.Uuid
  cuentaId           String       @db.Uuid
  estado             EstadoPedido @default(PENDIENTE)
  origen             OrigenPedido @default(CLIENTE)
  clientRequestId    String // idempotencia: único por cuenta
  creadoPorUsuarioId String?      @db.Uuid
  confirmadoPorId    String?      @db.Uuid
  confirmadoEn       DateTime? // arranca el temporizador de cocina
  listoAvisadoEn     DateTime? // cocina tocó "Listo · avisar mesero" (Fase 11)
  nota               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  restaurante   Restaurante  @relation(fields: [restauranteId], references: [id])
  cuenta        Cuenta       @relation(fields: [cuentaId], references: [id])
  creadoPor     Usuario?     @relation("PedidoCreadoPor", fields: [creadoPorUsuarioId], references: [id])
  confirmadoPor Usuario?     @relation("PedidoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  items         PedidoItem[]

  @@unique([cuentaId, clientRequestId])
  @@index([restauranteId, estado])
}

model PedidoItem {
  id                String           @id @default(uuid()) @db.Uuid
  pedidoId          String           @db.Uuid
  platoId           String           @db.Uuid
  estacionId        String           @db.Uuid
  cantidad          Int
  notas             String?
  precioUnitario    Int // céntimos, copia al momento del pedido
  tarifaIva         Int? // % de IVA del plato al pedir (null = el del restaurante)
  estado            EstadoPedidoItem @default(PENDIENTE)
  cancelado         Boolean          @default(false)
  motivoCancelacion String?
  enPreparacionEn   DateTime?
  listoEn           DateTime?
  entregadoEn       DateTime?
  pagoId            String?          @db.Uuid // cuentas separadas: en qué grupo se cobró
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  pedido        Pedido                  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato         Plato                   @relation(fields: [platoId], references: [id])
  estacion      Estacion                @relation(fields: [estacionId], references: [id])
  modificadores PedidoItemModificador[]
  pago          PagoCuenta?             @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([estacionId, estado])
}

model PedidoItemModificador {
  id            String   @id @default(uuid()) @db.Uuid
  pedidoItemId  String   @db.Uuid
  modificadorId String?  @db.Uuid
  nombre        String // copia
  precioExtra   Int // céntimos, copia
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pedidoItem  PedidoItem   @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  modificador Modificador? @relation(fields: [modificadorId], references: [id], onDelete: SetNull)

  @@index([pedidoItemId])
}

model Llamada {
  id            String      @id @default(uuid()) @db.Uuid
  restauranteId String      @db.Uuid
  mesaId        String      @db.Uuid
  tipo          TipoLlamada
  atendida      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  mesa        Mesa        @relation(fields: [mesaId], references: [id])

  @@index([restauranteId, atendida])
  @@index([mesaId])
}

// Sesión de un celular en una cuenta. Solo se guarda el hash del token.
model SesionCliente {
  id        String   @id @default(uuid()) @db.Uuid
  cuentaId  String   @db.Uuid
  tokenHash String   @unique
  creadaEn  DateTime @default(now())
  expiraEn  DateTime
  revocada  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuenta Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}

// Turnos de atención. Varios por día; si cierra < abre, el turno pasa de la medianoche.
model HorarioRestaurante {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  diaSemana     Int // 0 = domingo … 6 = sábado
  abre          String // "HH:mm"
  cierra        String // "HH:mm"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
}

// Tablet de cocina/bar vinculada con un código de 6 dígitos. Mientras no se vincula, tiene
// codigo y codigoExpira; al vincularse se borra el código y queda el hash del token.
model Dispositivo {
  id            String    @id @default(uuid()) @db.Uuid
  restauranteId String    @db.Uuid
  estacionId    String    @db.Uuid
  nombre        String
  codigo        String?   @unique
  codigoExpira  DateTime?
  tokenHash     String?   @unique
  vinculadoEn   DateTime?
  ultimoUso     DateTime?
  revocado      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  estacion    Estacion    @relation(fields: [estacionId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
}

// Vistas del detalle de un plato en el menú público: anónimas y agregadas por día local.
model VistaPlato {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  platoId       String   @db.Uuid
  dia           DateTime @db.Date
  vistas        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  plato       Plato       @relation(fields: [platoId], references: [id], onDelete: Cascade)

  @@unique([platoId, dia])
  @@index([restauranteId, dia])
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

// Alguien escanea el QR de una mesa con el cupo lleno: los que ya están en la mesa lo aceptan o
// rechazan. El que pide espera con una clave secreta (solo se guarda su hash).
model SolicitudIngreso {
  id        String          @id @default(uuid()) @db.Uuid
  cuentaId  String          @db.Uuid
  claveHash String          @unique
  estado    EstadoSolicitud @default(PENDIENTE)
  expiraEn  DateTime
  entregada Boolean         @default(false) // la sesión del aceptado ya se entregó
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  cuenta Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId, createdAt])
}

// Cuenta pagada por separado: cada grupo de ítems se cobra con su método y su propio comprobante.
model PagoCuenta {
  id            String     @id @default(uuid()) @db.Uuid
  cuentaId      String     @db.Uuid
  nombre        String? // "Ana", "Grupo 2"… (opcional)
  metodoPago    MetodoPago
  subtotal      Int
  montoServicio Int
  montoIva      Int
  total         Int
  cobradoPorId  String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  cuenta       Cuenta        @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  items        PedidoItem[]
  lineas       LineaCobro[]
  comprobantes Comprobante[]

  @@index([cuentaId])
}

// Detalle de un cobro en caja (Fase 13): cuánto en cada método. Un cobro mixto tiene varias.
// Sin pagoId = cobro de la cuenta completa; con pagoId = grupo de una cuenta separada.
model LineaCobro {
  id           String     @id @default(uuid()) @db.Uuid
  cuentaId     String     @db.Uuid
  pagoId       String?    @db.Uuid
  metodo       MetodoPago // EFECTIVO, TARJETA o SINPE
  monto        Int // céntimos
  recibido     Int? // efectivo: lo que entregó el cliente
  vuelto       Int        @default(0)
  ultimos4     String? // tarjeta
  autorizacion String? // tarjeta: número del voucher
  comprobante  String? // SINPE
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cuenta Cuenta      @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  pago   PagoCuenta? @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@index([pagoId])
}

// --- Clientes (Fase 8) ---

// Cuenta opcional del cliente de pedidos en línea; es de un solo restaurante.
model ClienteRegistrado {
  id             String   @id @default(uuid()) @db.Uuid
  restauranteId  String   @db.Uuid
  nombre         String
  email          String
  passwordHash   String
  telefono       String
  telefonoNormal String
  direccion      String?
  referencia     String?
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurante    Restaurante               @relation(fields: [restauranteId], references: [id])
  sesiones       SesionClienteRegistrado[]
  cuentas        Cuenta[]
  recuperaciones RecuperacionPassword[]

  @@unique([restauranteId, email])
  @@index([restauranteId, telefonoNormal])
}

// Sesión del cliente registrado: token opaco (en la BD solo su hash), 30 días.
model SesionClienteRegistrado {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @db.Uuid
  tokenHash String   @unique
  expiraEn  DateTime
  revocada  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente ClienteRegistrado @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// Premio canjeado: descuenta `sellos` del teléfono (sellos = entregados − canjeados).
model CanjeSello {
  id             String   @id @default(uuid()) @db.Uuid
  restauranteId  String   @db.Uuid
  telefonoNormal String
  sellos         Int
  premio         String
  usuarioId      String?  @db.Uuid // quién lo canjeó
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])

  @@index([restauranteId, telefonoNormal])
}

// --- Suscripción y cuentas (Fase 9) ---

enum Plan {
  BASICO
  COMPLETO
}

enum MetodoCobro {
  SINPE
  TRANSFERENCIA
  EFECTIVO
  OTRO
}

// Pago de la mensualidad que registra el superadmin; corre planVenceEn del restaurante.
model PagoSuscripcion {
  id              String      @id @default(uuid()) @db.Uuid
  restauranteId   String      @db.Uuid
  plan            Plan
  meses           Int
  monto           Int // céntimos
  metodo          MetodoCobro
  referencia      String?
  desde           DateTime
  hasta           DateTime
  registradoPorId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])

  @@index([restauranteId])
  @@index([createdAt])
}

// Enlace de "olvidé mi contraseña" (personal o cliente): un solo uso, vence en 1 hora.
model RecuperacionPassword {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String?   @db.Uuid
  clienteId String?   @db.Uuid
  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuario Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente ClienteRegistrado? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// --- Arqueo de caja (Fase 14) ---

// Turno de la gaveta: se abre con un fondo y se cierra contando el efectivo. Solo uno abierto por
// restaurante (índice único parcial en la migración). Al cerrar se guarda el resumen fijo.
model TurnoCaja {
  id               String    @id @default(uuid()) @db.Uuid
  restauranteId    String    @db.Uuid
  abiertoPorId     String    @db.Uuid
  abiertoPorNombre String
  abiertoEn        DateTime  @default(now())
  fondoInicial     Int // céntimos
  cerradoPorId     String?   @db.Uuid
  cerradoPorNombre String?
  cerradoEn        DateTime?
  ventasEfectivo   Int?
  ventasTarjeta    Int?
  ventasSinpe      Int?
  cuentas          Int?
  entradas         Int?
  salidas          Int?
  efectivoEsperado Int?
  efectivoContado  Int?
  diferencia       Int? // contado − esperado (negativo = faltante)
  nota             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurante Restaurante      @relation(fields: [restauranteId], references: [id])
  movimientos MovimientoCaja[]

  @@index([restauranteId, abiertoEn])
}

enum TipoMovimientoCaja {
  ENTRADA
  SALIDA
}

// Efectivo que entra o sale de la gaveta sin ser una venta (pago a un proveedor, retiro…).
model MovimientoCaja {
  id            String             @id @default(uuid()) @db.Uuid
  turnoId       String             @db.Uuid
  tipo          TipoMovimientoCaja
  monto         Int // céntimos
  motivo        String
  usuarioId     String             @db.Uuid
  usuarioNombre String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  turno TurnoCaja @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([turnoId])
}

// --- Factura electrónica (Fase 15) ---

// Datos de Hacienda de un restaurante. Credenciales, llave y PIN van cifrados (AES-256-GCM).
model ConfigHacienda {
  id               String    @id @default(uuid()) @db.Uuid
  restauranteId    String    @unique @db.Uuid
  activa           Boolean   @default(false)
  ambiente         String    @default("pruebas") // pruebas | produccion
  tipoId           String // 01 física, 02 jurídica, 03 DIMEX, 04 NITE
  numeroId         String
  nombre           String
  nombreComercial  String?
  correo           String
  provincia        Int
  canton           Int
  distrito         Int
  otrasSenas       String
  actividad        String // CIIU 4, "5610.0"
  usuarioCifrado   String
  claveCifrada     String
  llaveCifrada     String // .p12 en base64, cifrado
  pinCifrado       String
  llaveVence       DateTime? // vencimiento del certificado de la llave
  sucursal         Int       @default(1)
  terminal         Int       @default(1)
  siguienteTiquete Int       @default(1)
  siguienteFactura Int       @default(1)
  siguienteNota    Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
}

enum TipoComprobante {
  TE
  FE
  NC
}

enum EstadoComprobante {
  PENDIENTE // firmado, falta enviarlo
  ENVIADO // Hacienda lo recibió; falta la respuesta
  ACEPTADO
  RECHAZADO
  ERROR // no se pudo armar (falta CABYS, llave vencida…)
}

// Cola de comprobantes: uno por cobro. El proceso de envío los manda y consulta su estado.
model Comprobante {
  id             String            @id @default(uuid()) @db.Uuid
  restauranteId  String            @db.Uuid
  cuentaId       String            @db.Uuid
  pagoId         String?           @db.Uuid
  tipo           TipoComprobante
  numero         Int
  consecutivo    String
  clave          String            @unique
  fechaEmision   DateTime
  total          Int // céntimos
  ambiente       String
  estado         EstadoComprobante @default(PENDIENTE)
  mensaje        String? // respuesta de Hacienda o motivo del error
  xmlFirmado     String?
  respuestaXml   String?
  intentos       Int               @default(0)
  proximoIntento DateTime          @default(now())
  receptorNombre String?
  receptorTipoId String?
  receptorNumero String?
  receptorCorreo String?
  referenciaId   String?           @db.Uuid // nota de crédito: comprobante que anula
  razon          String? // nota de crédito: motivo de la anulación
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  cuenta      Cuenta      @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  pago        PagoCuenta? @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  @@unique([restauranteId, tipo, numero])
  @@index([estado, proximoIntento])
  @@index([cuentaId])
}
