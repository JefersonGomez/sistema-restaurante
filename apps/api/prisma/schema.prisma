generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Moneda {
  CRC
  USD
}

enum Idioma {
  es
  en
}

enum Rol {
  SUPERADMIN
  DUENO
  MESERO
  COCINA
  CAJA
}

enum EstadoCuenta {
  ABIERTA
  PIDIO_CUENTA
  CERRADA
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum EstadoPedidoItem {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
}

enum TipoLlamada {
  MESERO
  CUENTA
}

enum ModoConfirmacion {
  SIEMPRE
  PRIMER_PEDIDO
  NUNCA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  SINPE
  MIXTO
}

enum OrigenPedido {
  CLIENTE
  MESERO
}

model Restaurante {
  id                       String           @id @default(uuid()) @db.Uuid
  nombre                   String
  slug                     String           @unique
  logoUrl                  String?
  colorAcento              String? // acento del menú del comensal; null = morado del diseño
  moneda                   Moneda           @default(CRC)
  idiomas                  Idioma[]         @default([es, en])
  porcentajeIva            Int              @default(13)
  porcentajeServicio       Int              @default(10)
  preciosIncluyenImpuestos Boolean          @default(true)
  activo                   Boolean          @default(true)
  plan                     String           @default("basico")
  modoConfirmacion         ModoConfirmacion @default(PRIMER_PEDIDO)
  zonaHoraria              String           @default("America/Costa_Rica")
  cerradoManual            Boolean          @default(false) // "Cerrar temporalmente"
  // Promoción del banner: si hay precioPromo, es el precio que se cobra por ese plato.
  platoDestacadoId         String?          @db.Uuid
  textoPromoEs             String?
  textoPromoEn             String?
  precioPromo              Int? // céntimos
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  usuarios       Usuario[]
  dispositivos   Dispositivo[]
  estaciones     Estacion[]
  mesas          Mesa[]
  categorias     Categoria[]
  platos         Plato[]
  platoDestacado Plato?               @relation("PlatoDestacado", fields: [platoDestacadoId], references: [id], onDelete: SetNull)
  horarios       HorarioRestaurante[]
  grupos         GrupoModificadores[]
  modificadores  Modificador[]
  cuentas        Cuenta[]
  pedidos        Pedido[]
  llamadas       Llamada[]
}

model Usuario {
  id                  String    @id @default(uuid()) @db.Uuid
  restauranteId       String?   @db.Uuid // null solo para SUPERADMIN
  nombre              String
  email               String    @unique
  passwordHash        String
  debeCambiarPassword Boolean   @default(false) // tras restablecerla el dueño
  ultimoAcceso        DateTime?
  rol                 Rol
  estacionId          String?   @db.Uuid // COCINA: su estación; null = todas
  pinHash             String? // PIN de 4 dígitos para entrar en una tablet vinculada
  intentosPin         Int       @default(0)
  pinBloqueadoHasta   DateTime?
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  restaurante        Restaurante?   @relation(fields: [restauranteId], references: [id])
  estacion           Estacion?      @relation(fields: [estacionId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  pedidosConfirmados Pedido[]       @relation("PedidoConfirmadoPor")
  pedidosCreados     Pedido[]       @relation("PedidoCreadoPor")
  cuentasCerradas    Cuenta[]

  @@index([restauranteId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  tokenHash String   @unique
  expiraEn  DateTime
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Estacion {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  nombre        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante  Restaurante   @relation(fields: [restauranteId], references: [id])
  platos       Plato[]
  pedidoItems  PedidoItem[]
  usuarios     Usuario[]
  dispositivos Dispositivo[]

  @@unique([restauranteId, nombre])
  @@index([restauranteId])
}

model Mesa {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  numero        Int
  nombre        String?
  tokenQr       String   @unique
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  cuentas     Cuenta[]
  llamadas    Llamada[]

  @@unique([restauranteId, numero])
  @@index([restauranteId])
}

model Categoria {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  nombreEs      String
  nombreEn      String
  orden         Int      @default(0)
  activa        Boolean  @default(true)
  icono         String? // emoji que se muestra en el menú
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  platos      Plato[]

  @@index([restauranteId])
}

model Plato {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  categoriaId   String   @db.Uuid
  estacionId    String   @db.Uuid
  nombreEs      String
  nombreEn      String
  descripcionEs String?
  descripcionEn String?
  precio        Int // céntimos
  fotoUrl       String? // 960 px (detalle)
  fotoMiniUrl   String? // 320 px (lista)
  agotado       Boolean  @default(false)
  activo        Boolean  @default(true)
  orden         Int      @default(0)
  alergenos     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante          @relation(fields: [restauranteId], references: [id])
  destacadoEn Restaurante[]        @relation("PlatoDestacado")
  categoria   Categoria            @relation(fields: [categoriaId], references: [id])
  estacion    Estacion             @relation(fields: [estacionId], references: [id])
  grupos      GrupoModificadores[]
  pedidoItems PedidoItem[]

  @@index([restauranteId])
  @@index([categoriaId])
}

// restauranteId se agrega (no está en la spec) para filtrar por tenant sin joins.
model GrupoModificadores {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  platoId       String   @db.Uuid
  nombreEs      String
  nombreEn      String
  obligatorio   Boolean  @default(false)
  minimo        Int      @default(0)
  maximo        Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante   Restaurante   @relation(fields: [restauranteId], references: [id])
  plato         Plato         @relation(fields: [platoId], references: [id], onDelete: Cascade)
  modificadores Modificador[]

  @@index([restauranteId])
  @@index([platoId])
}

model Modificador {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  grupoId       String   @db.Uuid
  nombreEs      String
  nombreEn      String
  precioExtra   Int      @default(0) // céntimos
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante             @relation(fields: [restauranteId], references: [id])
  grupo       GrupoModificadores      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usos        PedidoItemModificador[]

  @@index([restauranteId])
  @@index([grupoId])
}

// --- Operación (Fase 2) ---

// Solo una cuenta no CERRADA por mesa: índice único parcial creado en SQL en la migración
// "cuenta_unica_abierta" (Prisma no soporta índices parciales en el schema).

model Cuenta {
  id               String       @id @default(uuid()) @db.Uuid
  restauranteId    String       @db.Uuid
  mesaId           String       @db.Uuid
  estado           EstadoCuenta @default(ABIERTA)
  verificada       Boolean      @default(false)
  // Totales en céntimos; los recalcula el servidor con calcularTotales() (packages/shared).
  subtotal         Int          @default(0)
  montoServicio    Int          @default(0)
  montoIva         Int          @default(0)
  total            Int          @default(0)
  metodoPago       MetodoPago?
  cerradaPorId     String?      @db.Uuid
  numeroComensales Int?
  abiertaEn        DateTime     @default(now())
  cerradaEn        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  restaurante Restaurante     @relation(fields: [restauranteId], references: [id])
  mesa        Mesa            @relation(fields: [mesaId], references: [id])
  cerradaPor  Usuario?        @relation(fields: [cerradaPorId], references: [id])
  pedidos     Pedido[]
  sesiones    SesionCliente[]

  @@index([restauranteId])
  @@index([mesaId])
}

model Pedido {
  id                 String       @id @default(uuid()) @db.Uuid
  restauranteId      String       @db.Uuid
  cuentaId           String       @db.Uuid
  estado             EstadoPedido @default(PENDIENTE)
  origen             OrigenPedido @default(CLIENTE)
  clientRequestId    String // idempotencia: único por cuenta
  creadoPorUsuarioId String?      @db.Uuid
  confirmadoPorId    String?      @db.Uuid
  confirmadoEn       DateTime? // arranca el temporizador de cocina
  nota               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  restaurante   Restaurante  @relation(fields: [restauranteId], references: [id])
  cuenta        Cuenta       @relation(fields: [cuentaId], references: [id])
  creadoPor     Usuario?     @relation("PedidoCreadoPor", fields: [creadoPorUsuarioId], references: [id])
  confirmadoPor Usuario?     @relation("PedidoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  items         PedidoItem[]

  @@unique([cuentaId, clientRequestId])
  @@index([restauranteId, estado])
}

model PedidoItem {
  id                String           @id @default(uuid()) @db.Uuid
  pedidoId          String           @db.Uuid
  platoId           String           @db.Uuid
  estacionId        String           @db.Uuid
  cantidad          Int
  notas             String?
  precioUnitario    Int // céntimos, copia al momento del pedido
  estado            EstadoPedidoItem @default(PENDIENTE)
  cancelado         Boolean          @default(false)
  motivoCancelacion String?
  enPreparacionEn   DateTime?
  listoEn           DateTime?
  entregadoEn       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  pedido        Pedido                  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato         Plato                   @relation(fields: [platoId], references: [id])
  estacion      Estacion                @relation(fields: [estacionId], references: [id])
  modificadores PedidoItemModificador[]

  @@index([pedidoId])
  @@index([estacionId, estado])
}

model PedidoItemModificador {
  id            String   @id @default(uuid()) @db.Uuid
  pedidoItemId  String   @db.Uuid
  modificadorId String?  @db.Uuid
  nombre        String // copia
  precioExtra   Int // céntimos, copia
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pedidoItem  PedidoItem   @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  modificador Modificador? @relation(fields: [modificadorId], references: [id], onDelete: SetNull)

  @@index([pedidoItemId])
}

model Llamada {
  id            String      @id @default(uuid()) @db.Uuid
  restauranteId String      @db.Uuid
  mesaId        String      @db.Uuid
  tipo          TipoLlamada
  atendida      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  mesa        Mesa        @relation(fields: [mesaId], references: [id])

  @@index([restauranteId, atendida])
  @@index([mesaId])
}

// Sesión de un celular en una cuenta. Solo se guarda el hash del token.
model SesionCliente {
  id        String   @id @default(uuid()) @db.Uuid
  cuentaId  String   @db.Uuid
  tokenHash String   @unique
  creadaEn  DateTime @default(now())
  expiraEn  DateTime
  revocada  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuenta Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}

// Turnos de atención. Varios por día; si cierra < abre, el turno pasa de la medianoche.
model HorarioRestaurante {
  id            String   @id @default(uuid()) @db.Uuid
  restauranteId String   @db.Uuid
  diaSemana     Int // 0 = domingo … 6 = sábado
  abre          String // "HH:mm"
  cierra        String // "HH:mm"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
}

// Tablet de cocina/bar vinculada con un código de 6 dígitos. Mientras no se vincula, tiene
// codigo y codigoExpira; al vincularse se borra el código y queda el hash del token.
model Dispositivo {
  id            String    @id @default(uuid()) @db.Uuid
  restauranteId String    @db.Uuid
  estacionId    String    @db.Uuid
  nombre        String
  codigo        String?   @unique
  codigoExpira  DateTime?
  tokenHash     String?   @unique
  vinculadoEn   DateTime?
  ultimoUso     DateTime?
  revocado      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  estacion    Estacion    @relation(fields: [estacionId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
}
