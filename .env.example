# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql://menuqr:menuqr@localhost:5433/menu_qr
DATABASE_URL_TEST=postgresql://menuqr:menuqr@localhost:5433/menu_qr_test

# API
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=cambiar-por-una-cadena-larga-aleatoria-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
MENU_PUBLIC_URL=http://localhost:5180

# Imágenes: local (desarrollo, se guardan en apps/api/uploads y se sirven en /uploads) o r2
STORAGE_DRIVER=local
# UPLOADS_DIR=apps/api/uploads
# API_PUBLIC_URL=http://localhost:4000   # base de las URLs de imágenes locales
# Cloudflare R2 (solo con STORAGE_DRIVER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://imagenes.tu-dominio.com

# Panel del personal: base de los enlaces de "olvidé mi contraseña"
STAFF_PUBLIC_URL=http://localhost:5181
# Correos con Resend (resend.com). Sin clave, los correos se escriben en la consola de la API.
# RESEND_API_KEY=re_...
# CORREO_REMITENTE=KitchaGo <no-responder@tu-dominio.com>   # dominio verificado en Resend
# WhatsApp de soporte que ve el dueño en el aviso de su plan (con código de país)
# SOPORTE_WHATSAPP=50688888888

# Frontends
VITE_API_URL=http://localhost:4000
# Landing: a dónde llevan los botones "Entrar" y "Probar gratis" (el panel del personal)
VITE_PANEL_URL=http://localhost:5181

# --- Factura electrónica (Fase 15) — AMBIENTE DE PRUEBAS de Hacienda ---
# Solo en el .env local. En producción cada restaurante guarda los suyos cifrados en la base.
# pruebas | produccion
HACIENDA_ENV=pruebas
# Usuario y clave de la API de comprobantes (ambiente de pruebas: ...@stag.comprobanteselectronicos.go.cr)
HACIENDA_USER=
HACIENDA_PASSWORD=
# Llave criptográfica .p12 (ruta fuera del repo) y su PIN
HACIENDA_P12_PATH=
HACIENDA_P12_PIN=
# Emisor de prueba: ubicación provincia-cantón-distrito (ej. 1-01-01) y código de actividad (CIIU 4, ej. 6201.0)
HACIENDA_TEST_UBICACION=
HACIENDA_ACTIVITY=
# Datos del emisor que el XML exige y no salen del usuario: nombre legal, correo y otras señas
HACIENDA_EMISOR_NOMBRE=
HACIENDA_EMISOR_CORREO=
HACIENDA_EMISOR_OTRAS_SENAS=
# Cédula de KitchaGo como proveedor de sistemas (va en cada comprobante; si falta, la del usuario de pruebas)
HACIENDA_PROVEEDOR_ID=
# Llave para cifrar en la base las credenciales de Hacienda de cada restaurante (no cambiarla después)
EINVOICE_SECRET=
