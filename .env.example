# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql://menuqr:menuqr@localhost:5433/menu_qr
DATABASE_URL_TEST=postgresql://menuqr:menuqr@localhost:5433/menu_qr_test

# API
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=cambiar-por-una-cadena-larga-aleatoria-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
MENU_PUBLIC_URL=http://localhost:5180

# Imágenes: local (desarrollo, se guardan en apps/api/uploads y se sirven en /uploads) o r2
STORAGE_DRIVER=local
# UPLOADS_DIR=apps/api/uploads
# API_PUBLIC_URL=http://localhost:4000   # base de las URLs de imágenes locales
# Cloudflare R2 (solo con STORAGE_DRIVER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://imagenes.tu-dominio.com

# Frontends
VITE_API_URL=http://localhost:4000
