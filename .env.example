# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql://menuqr:menuqr@localhost:5432/menu_qr
DATABASE_URL_TEST=postgresql://menuqr:menuqr@localhost:5432/menu_qr_test

# API
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=cambiar-por-una-cadena-larga-aleatoria-access
JWT_REFRESH_SECRET=cambiar-por-una-cadena-larga-aleatoria-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MENU_PUBLIC_URL=http://localhost:5173

# Frontends
VITE_API_URL=http://localhost:3000
